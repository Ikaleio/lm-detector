{
  "name": "lm-fingerpoint-detector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "web",
    "cli",
    "shared",
    "docs",
    "sdk/ts"
  ],
  "scripts": {
    "dev": "bun run sync-data && bun run --cwd web dev",
    "dev:docs": "bun run --cwd docs dev",
    "build": "bun run sync-data && bun run typecheck && bun run --cwd web build && bun run build:docs && bun run build:proxy",
    "build:proxy": "bun build api/proxy.ts --outfile web/dist/_worker.js --target browser",
    "build:docs": "bun run --cwd docs build && bun docs/scripts/publish.ts",
    "build:cli": "bun cli/build.ts",
    "build:sdk": "bun sdk/ts/build.ts",
    "build:data-package": "bun sdk/scripts/build-data-package.ts",
    "sdk:generate": "bun sdk/scripts/generate.ts",
    "sdk:check": "bun sdk/scripts/check.ts",
    "typecheck": "tsc --noEmit && bun run --cwd docs typecheck",
    "preview": "bun run --cwd web preview",
    "build:pages": "bun run build",
    "build:pages:upload": "bun run build:pages",
    "preview:pages": "wrangler pages dev web/dist --ip 127.0.0.1 --port 8788",
    "deploy:pages": "wrangler pages deploy web/dist",
    "dev:worker": "wrangler dev --config worker/wrangler.json --ip 127.0.0.1 --port 8787 --var ALLOWED_ORIGINS:http://127.0.0.1:5173,http://127.0.0.1:4173,https://lm.ikale.io",
    "deploy:worker": "wrangler deploy --config worker/wrangler.json",
    "deploy:proxy": "wrangler deploy -c wrangler.proxy.jsonc",
    "sync-data": "bun web/scripts/sync-data.ts",
    "detect": "bun cli/fpd.ts",
    "fpd": "bun cli/fpd.ts",
    "sample": "bun cli/fpd.ts sample",
    "vercel-build": "bun run build && rm web/dist/_worker.js",
    "enroll": "bun cli/fpd.ts enroll",
    "retrain": "bun cli/fpd.ts retrain"
  },
  "devDependencies": {
    "@fingerpoint/cli": "workspace:*",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.2"
  },
  "dependencies": {
    "ml-matrix": "6.15.0"
  }
}
